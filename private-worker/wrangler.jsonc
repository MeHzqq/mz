{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehz-private-index",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mehz.org/private*", "zone_name": "mehz.org" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://mehz.org"
  }
}
