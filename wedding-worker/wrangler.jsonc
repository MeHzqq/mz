{
  "name": "mehz-wedding",
  "main": "entry.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "mehz.org/wedding*", "zone_name": "mehz.org" }],
  "vars": { "SITE_ORIGIN": "https://mehz.org" },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "2026110101", "simple": { "limit": 5, "period": 60 } }]
}
